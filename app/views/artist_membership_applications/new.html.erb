<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-9">
      <p class="text-uppercase text-muted small">Закрытый клуб художников</p>
      <h1>Вступление через работу</h1>
      <p class="lead">Клуб не принимает спонсорские заявки и не продаёт статус. Вход проходит по профильному образованию или через экспертную оценку портфолио.</p>

      <% if @application.errors.any? %>
        <div class="alert alert-danger">
          <strong>Заявку пока нельзя отправить:</strong>
          <ul><% @application.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
        </div>
      <% end %>

      <%= form_with model: @application, url: club_application_path, local: true, html: { multipart: true } do |form| %>
        <div class="card mb-4">
          <div class="card-body">
            <h2 class="h4">Заявитель</h2>
            <div class="form-group"><%= form.label :display_name, 'Имя или творческий псевдоним' %><%= form.text_field :display_name, class: 'form-control', required: true %></div>
            <div class="form-group"><%= form.label :applicant_email, 'Email для статуса заявки' %><%= form.email_field :applicant_email, class: 'form-control', required: true %></div>
            <div class="form-group"><%= form.label :statement, 'Коротко о художественной практике' %><%= form.text_area :statement, rows: 4, class: 'form-control', required: true %></div>
            <div class="form-group"><%= form.label :education_documents, 'Документы об образовании — необязательно' %><%= form.file_field :education_documents, multiple: true, accept: 'image/*,application/pdf', class: 'form-control-file' %><small class="form-text text-muted">Документы видит только комиссия. Если диплома нет, оставьте поле пустым: оценка портфолио является равноправным путём.</small></div>
          </div>
        </div>

        <% [['drawing', 'Рисунок'], ['painting', 'Живопись'], ['composition', 'Композиция']].each do |category, label| %>
          <div class="card mb-4">
            <div class="card-body">
              <h2 class="h4"><%= label %></h2>
              <%= fields_for "works[#{category}]" do |work| %>
                <div class="form-group"><%= work.label :title, 'Название работы' %><%= work.text_field :title, class: 'form-control', required: true %></div>
                <div class="form-row"><div class="form-group col-md-6"><%= work.label :technique, 'Техника' %><%= work.text_field :technique, class: 'form-control' %></div><div class="form-group col-md-6"><%= work.label :year_created, 'Год' %><%= work.number_field :year_created, class: 'form-control', min: 1800, max: Time.current.year %></div></div>
                <div class="form-group"><%= work.label :author_note, 'Что решалось в работе' %><%= work.text_area :author_note, rows: 3, class: 'form-control', required: true %></div>
                <div class="form-group"><%= work.label :media, 'Файл работы' %><%= work.file_field :media, multiple: true, accept: 'image/*,video/*,audio/*', class: 'form-control-file', required: true %></div>
              <% end %>
            </div>
          </div>
        <% end %>

        <button type="submit" class="btn btn-primary btn-lg">Отправить на экспертную оценку</button>
      <% end %>
    </div>
  </div>
</div>
