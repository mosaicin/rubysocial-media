<div class="col-md-8">

<% if @post.present? %>
  <% @post.errors.each do |attr, msg| %>
    <div class="alert alert-danger" role="alert">
      <%= msg %>
    </div>
  <% end %>
<% end %>

<%= form_for(:post, url: path, method: "post", html: { multipart: true }) do %>
  <div class="form-group">
    <%= label(:post, :title, "Заголовок") %>
    <%= text_field(:post, :title, class: "form-control") %>
  </div>
  <div class="form-group">
    <%= label(:post, :topic, "Выберите тему") %>
    <%= select(:post, :topic, options_from_collection_for_select(@topics, "id", "title", @post.present? ? @post.topic_id : nil ), {}, {class: "form-control"}) %>
  </div>
  <div class="form-group">
    <%= label(:post, :body, "Текст") %>
    <%= text_area(:post, :body, class: "form-control", rows: "10") %>
  </div>
  <div class="form-group">
    <%= label(:post, :media, "Медиа-вложения") %>
    <%= file_field(:post, :media, multiple: true, direct_upload: true, accept: "image/*,video/*,audio/*", class: "form-control-file") %>
    <small class="form-text text-muted">До 10 файлов: изображения до 15 МБ, аудио до 100 МБ, видео до 250 МБ.</small>
  </div>
  <%= submit_tag(action == "edit" ? "Сохранить" : "Создать", class: "btn btn-primary") %>
<% end %>
</div>